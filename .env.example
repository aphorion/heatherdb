# HeatherDB compose environment.
#
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env
#     ${EDITOR:-vi} .env
#     docker compose up -d
#
# Loaded by docker-compose.yml's `env_file: .env` directive (optional —
# missing file is non-fatal; the engine then mints a random admin
# password on first boot and prints it once in the container log).

# ─── auth ─────────────────────────────────────────────────────────────────────
# First-boot admin user. Used only when the engine's user store is
# empty (i.e. fresh `heatherdb_data` volume). Once the user exists,
# both vars are ignored — rotate with:
#   docker compose exec heatherdb heather user passwd admin --password '...'
HEATHER_ADMIN_USER=admin
HEATHER_ADMIN_PASSWORD=

# DEV ONLY: disable HTTP Basic Auth entirely. Anyone who can reach
# the published port has full read+write access. Leave unset (or set
# to false) in any deploy you'd be sad to lose.
# HEATHER_AUTH_DISABLED=1
