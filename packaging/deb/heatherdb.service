[Unit]
Description=HeatherDB — associative-memory database
Documentation=https://github.com/aphorion/heather-db
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=heatherdb
Group=heatherdb
WorkingDirectory=/var/lib/heatherdb
ExecStart=/usr/bin/heather
Restart=always
RestartSec=2
LimitNOFILE=65536

# Override any of these in /etc/heatherdb/env (created by the package's
# postinst on first install, mode 0600 — edit there, then
# `systemctl restart heatherdb`).
EnvironmentFile=-/etc/heatherdb/env
Environment=HEATHER_DATA_DIR=/var/lib/heatherdb
Environment=HEATHER_DIMENSION=128
Environment=HEATHER_PORT=6380
# Loopback by default: the engine authenticates requests but has no notion of
# your application's users, so it is not a service to put on a public
# interface. Set HEATHER_HOST=0.0.0.0 in /etc/heatherdb/env deliberately, and
# firewall it, if something off-box genuinely needs to reach it.
Environment=HEATHER_HOST=127.0.0.1
# Applies ONLY to the auto-created `default` database, and only on the boot
# that creates it. Databases your application creates set their own ceiling via
# map_size_mb on POST /db — raising this will not resize them. To raise an
# existing one, edit map_size_mb in its db.toml and restart; no re-ingest.
Environment=HEATHER_MAP_SIZE_MB=4096
Environment=HEATHER_REQUEST_TIMEOUT=600
Environment=RUST_LOG=info

# Hardening — sane defaults for a network-facing single-process service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/heatherdb
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
