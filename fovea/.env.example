# Fovea web-mode authentication.
#
# Copy this file to ./fovea/.env and fill in real values:
#
#     cp fovea/.env.example fovea/.env
#
# Generate AUTH_PASS_HASH with caddy's bcrypt helper (no install needed):
#
#     docker run --rm caddy:2-alpine \
#       caddy hash-password --plaintext "your-password-here"
#
# Then paste the resulting $2a$… string here. Quote it if it contains $;
# env_file does not need shell-style escaping.
#
# Leave both blank to run with NO AUTH (the entrypoint will print a loud
# warning and serve the inspector + /api/* unauthenticated). Don't do
# this on a network anyone else can reach.

AUTH_USER=
AUTH_PASS_HASH=
